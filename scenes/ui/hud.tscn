[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/ui/clock_panel.gd" id="2_clock"]
[ext_resource type="Script" path="res://scripts/ui/needs_panel.gd" id="3_needs"]
[ext_resource type="Script" path="res://scripts/ui/action_queue_panel.gd" id="4_queue"]
[ext_resource type="Script" path="res://scripts/ui/context_menu.gd" id="5_menu"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="TopBar" type="PanelContainer" parent="."]
anchors_preset = 10
anchor_right = 1.0
offset_bottom = 44.0
grow_horizontal = 2

[node name="Margin" type="MarginContainer" parent="TopBar"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 4
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 4

[node name="ClockPanel" type="HBoxContainer" parent="TopBar/Margin"]
layout_mode = 2
script = ExtResource("2_clock")

[node name="LeftPanel" type="PanelContainer" parent="."]
offset_left = 8.0
offset_top = 52.0
offset_right = 240.0
offset_bottom = 300.0

[node name="Margin" type="MarginContainer" parent="LeftPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="LeftPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="CharacterName" type="Label" parent="LeftPanel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "—"

[node name="NeedsPanel" type="VBoxContainer" parent="LeftPanel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("3_needs")

[node name="AutonomyCheck" type="CheckBox" parent="LeftPanel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "Autonomie"

[node name="RightPanel" type="PanelContainer" parent="."]
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -248.0
offset_top = 52.0
offset_right = -8.0
offset_bottom = 380.0
grow_horizontal = 0

[node name="Margin" type="MarginContainer" parent="RightPanel"]
layout_mode = 2
theme_override_constants/margin_left = 10
theme_override_constants/margin_top = 8
theme_override_constants/margin_right = 10
theme_override_constants/margin_bottom = 8

[node name="Content" type="VBoxContainer" parent="RightPanel/Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="RightPanel/Margin/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "File d'actions"

[node name="ActionQueuePanel" type="VBoxContainer" parent="RightPanel/Margin/Content"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("4_queue")

[node name="ContextMenu" type="PopupMenu" parent="."]
script = ExtResource("5_menu")
