[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scripts/ui/clock_panel.gd" id="2_clock"]
[ext_resource type="Script" path="res://scripts/ui/needs_panel.gd" id="3_needs"]
[ext_resource type="Script" path="res://scripts/ui/action_queue_panel.gd" id="4_queue"]
[ext_resource type="Script" path="res://scripts/ui/context_menu.gd" id="5_menu"]
[ext_resource type="Script" path="res://scripts/ui/relationship_panel.gd" id="6_relations"]
[ext_resource type="Script" path="res://scripts/ui/character_switcher.gd" id="7_switcher"]
[ext_resource type="Script" path="res://scripts/ui/speed_controls.gd" id="8_speed"]
[ext_resource type="Script" path="res://scripts/ui/mouz_header.gd" id="9_header"]

[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="TopBar" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 10
anchor_right = 1.0
offset_left = 12.0
offset_top = 12.0
offset_right = -12.0
offset_bottom = 64.0
grow_horizontal = 2

[node name="Row" type="HBoxContainer" parent="Root/TopBar"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Logo" type="Label" parent="Root/TopBar/Row"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Les Mouz"

[node name="CharacterSwitcher" type="HBoxContainer" parent="Root/TopBar/Row"]
layout_mode = 2
script = ExtResource("7_switcher")

[node name="SpacerLeft" type="Control" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="ClockPanel" type="HBoxContainer" parent="Root/TopBar/Row"]
layout_mode = 2
script = ExtResource("2_clock")

[node name="SpacerRight" type="Control" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="SpeedGroup" type="PanelContainer" parent="Root/TopBar/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"SpeedGroup"

[node name="SpeedControls" type="HBoxContainer" parent="Root/TopBar/Row/SpeedGroup"]
layout_mode = 2
script = ExtResource("8_speed")

[node name="Separator" type="VSeparator" parent="Root/TopBar/Row"]
layout_mode = 2

[node name="AutonomyToggle" type="Button" parent="Root/TopBar/Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
focus_mode = 0
theme_type_variation = &"ToggleChip"
toggle_mode = true
text = "Autonomie"

[node name="LeftColumn" type="VBoxContainer" parent="Root"]
layout_mode = 0
offset_left = 12.0
offset_top = 76.0
offset_right = 284.0
offset_bottom = 76.0
theme_override_constants/separation = 12

[node name="MouzPanel" type="PanelContainer" parent="Root/LeftColumn"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Root/LeftColumn/MouzPanel"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="MouzHeader" type="HBoxContainer" parent="Root/LeftColumn/MouzPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("9_header")

[node name="NeedsPanel" type="VBoxContainer" parent="Root/LeftColumn/MouzPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12
script = ExtResource("3_needs")

[node name="RelationPanel" type="PanelContainer" parent="Root/LeftColumn"]
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Root/LeftColumn/RelationPanel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Root/LeftColumn/RelationPanel/Content"]
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "RELATION"

[node name="RelationshipPanel" type="VBoxContainer" parent="Root/LeftColumn/RelationPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("6_relations")

[node name="RightPanel" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 1
anchor_left = 1.0
anchor_right = 1.0
offset_left = -284.0
offset_top = 76.0
offset_right = -12.0
offset_bottom = 76.0
grow_horizontal = 0

[node name="Content" type="VBoxContainer" parent="Root/RightPanel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Root/RightPanel/Content"]
layout_mode = 2

[node name="Title" type="Label" parent="Root/RightPanel/Content/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SectionTitle"
text = "FILE D'ACTIONS"

[node name="QueueCount" type="Label" parent="Root/RightPanel/Content/Header"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"SectionTitle"
text = "0"

[node name="ActionQueuePanel" type="VBoxContainer" parent="Root/RightPanel/Content"]
unique_name_in_owner = true
layout_mode = 2
script = ExtResource("4_queue")

[node name="Help" type="Label" parent="Root/RightPanel/Content"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Clique sur un objet ou sur l'autre Mouz pour ajouter une action."
autowrap_mode = 3

[node name="ContextMenu" type="PopupMenu" parent="."]
script = ExtResource("5_menu")
