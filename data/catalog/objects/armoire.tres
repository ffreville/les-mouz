[resource]
script = ExtResource("1_object")
id = &"armoire"
display_name = "Armoire"
sprites = Dictionary[StringName, Texture2D]({&"nature": ExtResource("3_nature"), &"retro": ExtResource("4_retro"), &"moderne": ExtResource("5_moderne")})
