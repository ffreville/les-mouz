[gd_resource type="Resource" script_class="SmartObjectDefinition" format=3]

[ext_resource type="Script" path="res://scripts/objects/smart_object_definition.gd" id="1_object"]
[ext_resource type="Script" path="res://scripts/objects/action_definition.gd" id="2_action"]
[ext_resource type="Texture2D" path="res://assets/sprites/ordinateur_nature.svg" id="3_nature"]
[ext_resource type="Texture2D" path="res://assets/sprites/ordinateur_nature_actif.svg" id="4_nature_actif"]
[ext_resource type="Texture2D" path="res://assets/sprites/ordinateur_retro.svg" id="5_retro"]
[ext_resource type="Texture2D" path="res://assets/sprites/ordinateur_retro_actif.svg" id="6_retro_actif"]
[ext_resource type="Texture2D" path="res://assets/sprites/ordinateur_moderne.svg" id="7_moderne"]
[ext_resource type="Texture2D" path="res://assets/sprites/ordinateur_moderne_actif.svg" id="8_moderne_actif"]
[ext_resource type="Resource" path="res://data/actions/surfer.tres" id="9_surfer"]
[ext_resource type="Resource" path="res://data/actions/jouer_en_ligne.tres" id="10_jouer_en_ligne"]
[ext_resource type="Resource" path="res://data/actions/discuter_en_ligne.tres" id="11_discuter_en_ligne"]
[ext_resource type="Resource" path="res://data/actions/chercher_emploi.tres" id="12_chercher_emploi"]
[ext_resource type="Resource" path="res://data/actions/freelance.tres" id="99_freelance"]

[resource]
script = ExtResource("1_object")
id = &"ordinateur"
display_name = "Ordinateur"
sprites = Dictionary[StringName, Texture2D]({&"nature": ExtResource("3_nature"), &"retro": ExtResource("5_retro"), &"moderne": ExtResource("7_moderne")})
active_sprites = Dictionary[StringName, Texture2D]({&"nature": ExtResource("4_nature_actif"), &"retro": ExtResource("6_retro_actif"), &"moderne": ExtResource("8_moderne_actif")})
size = Vector2i(2, 1)
blocks_movement = true
actions = Array[ExtResource("2_action")]([ExtResource("9_surfer"), ExtResource("10_jouer_en_ligne"), ExtResource("11_discuter_en_ligne"), ExtResource("12_chercher_emploi"), ExtResource("99_freelance")])
capacity = 1
price = 900
category = &"loisirs"
wear_per_hour = 3.0
