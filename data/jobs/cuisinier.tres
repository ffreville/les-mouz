[gd_resource type="Resource" script_class="JobDefinition" format=3]

[ext_resource type="Script" path="res://scripts/jobs/job_definition.gd" id="1_job"]
[ext_resource type="Texture2D" path="res://assets/icons/ink/cuisiner.svg" id="2_icon"]

[resource]
script = ExtResource("1_job")
id = &"cuisinier"
display_name = "Commis de cuisine"
description = "Le bistrot du coin cherche quelqu'un pour éplucher, mijoter et goûter les sauces."
icon = ExtResource("2_icon")
salary = 210
start_hour = 10
end_hour = 18
days = Array[int]([1, 2, 3, 4, 5])
min_age = &"adulte"
need_changes = Dictionary[StringName, float]({&"energie": -25.0, &"faim": 10.0, &"plaisir": -5.0})
