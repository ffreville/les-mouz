[gd_resource type="Resource" script_class="JobDefinition" format=3]

[ext_resource type="Script" path="res://scripts/jobs/job_definition.gd" id="1_job"]
[ext_resource type="Texture2D" path="res://assets/icons/ink/jardiner.svg" id="2_icon"]

[resource]
script = ExtResource("1_job")
id = &"jardinier"
display_name = "Jardinier·ère paysagiste"
description = "Tailler, planter, arroser les jardins du quartier, au grand air."
icon = ExtResource("2_icon")
salary = 190
start_hour = 8
end_hour = 15
days = Array[int]([0, 1, 2, 3, 4])
min_age = &"adulte"
need_changes = Dictionary[StringName, float]({&"energie": -30.0, &"hygiene": -20.0, &"plaisir": 5.0})
