[gd_resource type="Resource" script_class="JobDefinition" format=3]

[ext_resource type="Script" path="res://scripts/jobs/job_definition.gd" id="1_job"]
[ext_resource type="Texture2D" path="res://assets/icons/ink/lire.svg" id="2_icon"]

[resource]
script = ExtResource("1_job")
id = &"libraire"
display_name = "Libraire"
description = "Conseiller, ranger, emballer : la librairie des Tilleuls recrute."
icon = ExtResource("2_icon")
salary = 180
start_hour = 10
end_hour = 18
days = Array[int]([1, 2, 3, 4, 5])
min_age = &"adulte"
need_changes = Dictionary[StringName, float]({&"energie": -20.0, &"social": 10.0})
skill = &"culture"
grades = Array[String](["Libraire", "Libraire conseil", "Responsable de rayon", "Gérant·e", "Éditeur·rice"])
grade_salaries = Array[int]([180, 230, 290, 360, 450])
grade_levels = Array[int]([0, 2, 4, 6, 8])
