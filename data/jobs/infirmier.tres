[gd_resource type="Resource" script_class="JobDefinition" format=3]

[ext_resource type="Script" path="res://scripts/jobs/job_definition.gd" id="1_job"]
[ext_resource type="Texture2D" path="res://assets/icons/ink/hygiene.svg" id="2_icon"]

[resource]
script = ExtResource("1_job")
id = &"infirmier"
display_name = "Infirmier·ère"
description = "Le centre de soins cherche une personne douce et organisée."
icon = ExtResource("2_icon")
salary = 260
start_hour = 7
end_hour = 15
days = Array[int]([0, 1, 2, 3, 4])
min_age = &"adulte"
need_changes = Dictionary[StringName, float]({&"energie": -30.0, &"plaisir": -5.0, &"social": 5.0})
skill = &"charisme"
grades = Array[String](["Infirmier·ère", "Infirmier·ère confirmé·e", "Cadre de santé", "Coordinateur·rice de soins", "Directeur·rice des soins"])
grade_salaries = Array[int]([260, 320, 390, 480, 590])
grade_levels = Array[int]([0, 2, 4, 6, 8])
